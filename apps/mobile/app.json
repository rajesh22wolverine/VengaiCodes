{
  "expo": {
    "name": "VengaiCode Mobile",
    "slug": "vengaicode-mobile",
    "owner": "vengaicode",
    "platforms": [
      "android",
      "ios"
    ],
    "scheme": "vengaicode",
    "version": "0.2.0",
    "android": {
      "package": "com.vengaicode.mobile",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow VengaiCode to access your microphone to record voice notes for your app designs."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VengaiCode to access your photos so you can upload a design mockup.",
          "cameraPermission": "Allow VengaiCode to use your camera to capture a design sketch or mockup."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VengaiCode to use your camera to scan QR codes of shared projects.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd862d0d-90d4-4c15-adfa-3ead014a09b2"
      }
    }
  }
}
