{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Module Resolution */
    "baseUrl": ".",
    "paths": {
      /* React's types are this app's own @types/react (18), for every import —
         including the ones inside libraries' type files. lucide-react,
         framer-motion, react-router and others don't declare @types/react, so
         pnpm links them none and TypeScript would take whichever copy pnpm
         hoisted: the workspace also has 19 (apps/mobile), and which one is
         hoisted isn't fixed, so the typecheck failed at random. The targets
         are .d.ts files, so only TypeScript follows these (Vite ignores
         tsconfig paths anyway; the .d.ts form matches apps/mobile, where
         Expo's bundler reads paths but skips .d.ts targets). */
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*.d.ts"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*.d.ts"],
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@screens/*": ["./src/screens/*"],
      "@store/*": ["./src/store/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@styles/*": ["./src/styles/*"],
      "@types/*": ["./src/types/*"],
      "@vengaicode/ui": ["../../packages/ui/src"],
      "@vengaicode/ui/*": ["../../packages/ui/src/*"],
      "@vengaicode/ai": ["../../packages/ai/src"],
      "@vengaicode/ai/*": ["../../packages/ai/src/*"],
      "@vengaicode/utils": ["../../packages/utils/src"],
      "@vengaicode/utils/*": ["../../packages/utils/src/*"],
      "@vengaicode/types": ["../../packages/types/src"],
      "@vengaicode/types/*": ["../../packages/types/src/*"]
    },
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,

    /* Bundler-specific */
    "moduleDetection": "force",
    "allowJs": false,
    "isolatedModules": true,
    "noEmit": true,

    /* Type Checking — Strict Mode */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src-tauri", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
